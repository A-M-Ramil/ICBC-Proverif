(* =====================================================================
   P3 + P4 + P5: Credential issuance, presentation and revocation
   Thesis Sec 6.3-6.5 / prototype: issuer /protocol3/issue-credential,
   /protocol5/revoke, verifier /protocol4/request-proof + check-proof,
   CredentialRegistry.{issueCredential, revokeCredential, verifyCredential}
   Tool: ProVerif 2.05      Run: proverif p345_credential_lifecycle.pv
   ---------------------------------------------------------------------
   Cryptographic abstraction of AnonCreds (ACA-Py + BC Wallet):
   - credential  = sign((tCred, (commit(ls), lid)), skI): CL signature on
     the holder's blinded link secret ls and the license id lid.
   - presentation = zkp(cred, ls, n): proof of knowledge of a credential
     and of ls, bound to the verifier nonce n, revealing lid and the
     cred-def key. No destructor returns cred or ls (zero knowledge).
   - The on-chain anchor key is h(lid) = keccak("cred_" + license_id).
   Threat model: Dolev-Yao on c; attacker may obtain its own credentials
   from the honest issuer (IssuerPublic); key-reuse oracle on the
   issuer's Ethereum account.
   Channel assumptions:
   - dc: DIDComm connection issuer <-> honest holder (authcrypt, set up
     out of band by QR) = private. Credential delivery itself is public.
   - stA: the verifier's read of contract storage (local node, eth_call)
     = trusted private channel. ack: tx receipt to the issuer = private.
   Time abstraction (phases):
   - phase 0: issuance, presentation, revocation txs.
   - phase 1: every revocation tx sent in phase 0 has been mined; the
     registry now reports Revoked for those anchors. Unrevoked
     credentials are not served in phase 1 (safety-only modelling).
   ===================================================================== *)

free c: channel.
free dc: channel [private].
free ack: channel [private].
free stA: channel [private].

type skey.
type pkey.
type tag.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
reduc forall m: bitstring, k: skey; getmess(sign(m, k)) = m.
fun h(bitstring): bitstring.

const tCred: tag.
const tTx: tag.

fun commit(bitstring): bitstring.
fun zkp(bitstring, bitstring, bitstring): bitstring.
reduc forall ls: bitstring, lid: bitstring, n: bitstring, k: skey;
  openPres(zkp(sign((tCred, (commit(ls), lid)), k), ls, n)) = (lid, pk(k), n).

const addrCred: bitstring.
const selIssue, selRevoke: bitstring.
const validSt, revokedSt: bitstring.

free skI: skey [private].      (* AnonCreds cred-def key held by issuer ACA-Py *)
free skIeth: skey [private].   (* issuer's Ethereum account = CredentialRegistry.issuer *)

table anchoredT(bitstring).
table revokedT(bitstring).
table issuedT(bitstring).
table walletT(bitstring, bitstring, bitstring).   (* cred, ls, lid: BC Wallet storage *)

event HolderGot(bitstring).
event Presented(bitstring, bitstring).
event Accepted(bitstring, bitstring).
event AcceptedP1(bitstring, bitstring).
event Issued(bitstring).
event IssuedCorrupt(bitstring).
event IssuerAnchors(bitstring).
event Anchored(bitstring).
event IssuerRevokes(bitstring).
event Revoked(bitstring).

(* ---------------- Sanity. EXPECT: false = reachable ------------------ *)
query lid: bitstring, n: bitstring;
  event(Accepted(lid, n)) && event(HolderGot(lid)) ==> false.
query x: bitstring; event(Revoked(x)).

(* ---------------- Secrecy. EXPECT: true ------------------------------ *)
query attacker(skI).
query attacker(skIeth).
query secret ls.

(* ---------------- C1 (P4): holder binding + anti-replay. Every accepted
   presentation was produced, for this verifier session, by the holder
   of the credential (or the credential was issued to the attacker).
   EXPECT: true ------------------------------------------------------- *)
query lid: bitstring, n: bitstring;
  inj-event(Accepted(lid, n)) ==> inj-event(Presented(lid, n)) || event(IssuedCorrupt(lid)).

(* ---------------- C2 (P3/P4): accepted credentials were issued by the
   trusted issuer. EXPECT: true --------------------------------------- *)
query lid: bitstring, n: bitstring;
  event(Accepted(lid, n)) ==> event(Issued(lid)) || event(IssuedCorrupt(lid)).

(* ---------------- C3 (S2): only the issuer can create anchors.
   EXPECT: true ------------------------------------------------------- *)
query x: bitstring; event(Anchored(x)) ==> event(IssuerAnchors(x)).

(* ---------------- C4 (S1): only the issuer can revoke. EXPECT: true -- *)
query x: bitstring; event(Revoked(x)) ==> event(IssuerRevokes(x)).

(* ---------------- C5 (S4 end to end): after revocation is mined, no
   verifier accepts the credential, including replays of presentations
   captured before revocation. EXPECT: true ---------------------------- *)
query lid: bitstring, n: bitstring;
  event(AcceptedP1(lid, n)) && event(Revoked(h(lid))) ==> false.

(* ===================================================================== *)

let KeyReuseOracle(sk: skey) =
    (!in(c, (t: tag, m: bitstring));
       if t <> tTx && t <> tCred then out(c, sign((t, m), sk)))
  | (!in(c, (dest: bitstring, call: bitstring));
       if dest <> addrCred then out(c, sign((tTx, (dest, call)), sk))).

(* ---- Holder (BC Wallet) ---- *)
let Holder =
  new ls: bitstring;
  out(dc, commit(ls));
  in(c, cr: bitstring);
  let (=tCred, (=commit(ls), lid: bitstring)) = checksign(cr, pk(skI)) in
  event HolderGot(lid);
  insert walletT(cr, ls, lid);
  !( in(c, n: bitstring);
     event Presented(lid, n);
     out(c, zkp(cr, ls, n)) ).

let HolderP1 =
  get walletT(cr: bitstring, ls2: bitstring, lid: bitstring) in
  !( in(c, n: bitstring);
     event Presented(lid, n);
     out(c, zkp(cr, ls2, n)) ).

(* ---- Issuer: anchor on chain first, then deliver (as in main.py) ---- *)
let Issuer =
  in(dc, cm: bitstring);
  new lid: bitstring;
  event IssuerAnchors(h(lid));
  out(c, (pk(skIeth), sign((tTx, (addrCred, (selIssue, h(lid)))), skIeth)));
  in(ack, =h(lid));
  event Issued(lid);
  insert issuedT(lid);
  out(c, sign((tCred, (cm, lid)), skI)).

(* the attacker obtains genuine credentials for its own link secrets *)
let IssuerPublic =
  in(c, cm: bitstring);
  new lid: bitstring;
  event IssuerAnchors(h(lid));
  out(c, (pk(skIeth), sign((tTx, (addrCred, (selIssue, h(lid)))), skIeth)));
  in(ack, =h(lid));
  event IssuedCorrupt(lid);
  insert issuedT(lid);
  out(c, sign((tCred, (cm, lid)), skI)).

(* P5: the issuer may revoke any credential it issued *)
let IssuerRevoker =
  get issuedT(lid: bitstring) in
  event IssuerRevokes(h(lid));
  out(c, (pk(skIeth), sign((tTx, (addrCred, (selRevoke, h(lid)))), skIeth))).

(* ---- CredentialRegistry.sol (onlyIssuer = msg.sender == issuer) ---- *)
let RegIssue =
  in(c, (sender: pkey, stx: bitstring));
  let (=tTx, (=addrCred, (=selIssue, x: bitstring))) = checksign(stx, sender) in
  (*CHK:only_issuer_issue*) if sender = pk(skIeth) then
  event Anchored(x);
  insert anchoredT(x);
  out(ack, x).

let RegRevoke =
  in(c, (sender: pkey, stx: bitstring));
  let (=tTx, (=addrCred, (=selRevoke, x: bitstring))) = checksign(stx, sender) in
  (*CHK:only_issuer_revoke*) if sender = pk(skIeth) then
  get anchoredT(=x) in
  event Revoked(x);
  insert revokedT(x).

let StatusP0 = get anchoredT(x: bitstring) in out(stA, (x, validSt)).
let StatusP1 = get revokedT(x: bitstring) in out(stA, (x, revokedSt)).

(* ---- Verifier (ACA-Py verifier + check-proof + verifyCredential) ---- *)
let Verifier =
  new n: bitstring;
  out(c, n);
  in(c, p: bitstring);
  let (lid: bitstring, ipk: pkey, n2: bitstring) = openPres(p) in
  (*CHK:issuer_trusted*) if ipk = pk(skI) then
  (*CHK:nonce_fresh*) if n2 = n then
  in(stA, (=h(lid), st: bitstring));
  (*CHK:status_valid*) if st = validSt then
  event Accepted(lid, n).

let VerifierP1 =
  new n: bitstring;
  out(c, n);
  in(c, p: bitstring);
  let (lid: bitstring, ipk: pkey, n2: bitstring) = openPres(p) in
  (*CHK:issuer_trusted*) if ipk = pk(skI) then
  (*CHK:nonce_fresh*) if n2 = n then
  in(stA, (=h(lid), st: bitstring));
  (*CHK:status_valid*) if st = validSt then
  event AcceptedP1(lid, n).

process
  out(c, pk(skI));
  out(c, pk(skIeth));
  (
    (!Holder)
  | (!Issuer)
  | (!IssuerPublic)
  | (!IssuerRevoker)
  | (!RegIssue)
  | (!RegRevoke)
  | (!StatusP0)
  | (!Verifier)
  | KeyReuseOracle(skIeth)
  | (phase 1; ((!HolderP1) | (!StatusP1) | (!VerifierP1)))
  )
